{
  "name": "KumoYomi Extensions Source (Bundle Autonome)",
  "description": "Archive JSON autonome contenant tous les modèles et toutes les sources.",
  "version": "1.0.0",
  "templates": [
    {
      "id": "madara",
      "name": "Modèle Madara (WordPress WP-Manga)",
      "lang": "fr",
      "vars": {
        "mangaSubString": "manga"
      },
      "popular": {
        "request": {
          "method": "POST",
          "url": "{{baseUrl}}/wp-admin/admin-ajax.php",
          "headers": {
            "X-Requested-With": "XMLHttpRequest"
          },
          "formBody": {
            "action": "madara_load_more",
            "page": "{{pageZero}}",
            "template": "madara-core/content/content-archive",
            "vars[paged]": "1",
            "vars[template]": "archive",
            "vars[posts_per_page]": "20",
            "vars[post_type]": "wp-manga",
            "vars[post_status]": "publish",
            "vars[manga_archives_item_layout]": "big_thumbnail",
            "vars[orderby]": "meta_value_num",
            "vars[meta_key]": "_wp_manga_views",
            "vars[order]": "DESC"
          },
          "responseType": "html"
        },
        "itemSelector": "div.page-item-detail, .manga__item, .c-tabs-item__content",
        "pageSize": 20,
        "fields": {
          "title": {
            "selector": ".post-title a",
            "attr": "text"
          },
          "url": {
            "selector": ".post-title a",
            "attr": "href",
            "absoluteUrl": true
          },
          "cover": {
            "selector": "img",
            "attr": [
              "data-src",
              "data-lazy-src",
              "src"
            ],
            "absoluteUrl": true
          },
          "latestChapter": {
            "selector": ".chapter-item .chapter a, .latest-chap .chapter a",
            "attr": "text"
          }
        }
      },
      "latest": {
        "request": {
          "method": "POST",
          "url": "{{baseUrl}}/wp-admin/admin-ajax.php",
          "headers": {
            "X-Requested-With": "XMLHttpRequest"
          },
          "formBody": {
            "action": "madara_load_more",
            "page": "{{pageZero}}",
            "template": "madara-core/content/content-archive",
            "vars[paged]": "1",
            "vars[template]": "archive",
            "vars[posts_per_page]": "20",
            "vars[post_type]": "wp-manga",
            "vars[post_status]": "publish",
            "vars[manga_archives_item_layout]": "big_thumbnail",
            "vars[orderby]": "meta_value_num",
            "vars[meta_key]": "_latest_update",
            "vars[order]": "DESC"
          },
          "responseType": "html"
        },
        "itemSelector": "div.page-item-detail, .manga__item, .c-tabs-item__content",
        "pageSize": 20,
        "fields": {
          "title": {
            "selector": ".post-title a",
            "attr": "text"
          },
          "url": {
            "selector": ".post-title a",
            "attr": "href",
            "absoluteUrl": true
          },
          "cover": {
            "selector": "img",
            "attr": [
              "data-src",
              "data-lazy-src",
              "src"
            ],
            "absoluteUrl": true
          },
          "latestChapter": {
            "selector": ".chapter-item .chapter a, .latest-chap .chapter a",
            "attr": "text"
          }
        }
      },
      "search": {
        "request": {
          "method": "POST",
          "url": "{{baseUrl}}/wp-admin/admin-ajax.php",
          "headers": {
            "X-Requested-With": "XMLHttpRequest"
          },
          "formBody": {
            "action": "madara_load_more",
            "page": "{{pageZero}}",
            "template": "madara-core/content/content-archive",
            "vars[paged]": "1",
            "vars[template]": "archive",
            "vars[posts_per_page]": "20",
            "vars[post_type]": "wp-manga",
            "vars[post_status]": "publish",
            "vars[manga_archives_item_layout]": "big_thumbnail",
            "vars[s]": "{{query}}"
          },
          "responseType": "html"
        },
        "itemSelector": "div.page-item-detail, .manga__item, .c-tabs-item__content",
        "pageSize": 20,
        "fields": {
          "title": {
            "selector": ".post-title a",
            "attr": "text"
          },
          "url": {
            "selector": ".post-title a",
            "attr": "href",
            "absoluteUrl": true
          },
          "cover": {
            "selector": "img",
            "attr": [
              "data-src",
              "data-lazy-src",
              "src"
            ],
            "absoluteUrl": true
          }
        }
      },
      "mangaDetails": {
        "request": {
          "method": "GET",
          "url": "{{mangaUrl}}"
        },
        "fields": {
          "title": {
            "selector": "div.post-title h1, div.post-title h3, #manga-title > h1",
            "attr": [
              "ownText",
              "text"
            ]
          },
          "cover": {
            "selector": "div.summary_image img",
            "attr": [
              "data-src",
              "data-lazy-src",
              "src"
            ],
            "absoluteUrl": true
          },
          "author": {
            "selector": "div.author-content > a, div.manga-authors > a",
            "attr": "text",
            "joinAll": ", "
          },
          "artist": {
            "selector": "div.artist-content > a",
            "attr": "text",
            "joinAll": ", "
          },
          "status": {
            "selector": "div.post-content_item div.summary-heading",
            "labelMatch": [
              "status",
              "statut",
              "état"
            ],
            "attr": "text"
          },
          "description": {
            "selector": "div.description-summary div.summary__content p, div.summary__content",
            "attr": "text",
            "joinAll": "\n\n"
          },
          "genres": {
            "selector": "div.genres-content a",
            "attr": "text",
            "joinAll": ", "
          }
        }
      },
      "chapters": {
        "request": {
          "method": "POST",
          "url": "{{mangaUrlSlash}}ajax/chapters/",
          "headers": {
            "X-Requested-With": "XMLHttpRequest"
          }
        },
        "fallbackInline": true,
        "itemSelector": "li.wp-manga-chapter",
        "fields": {
          "title": {
            "selector": "a",
            "attr": "text"
          },
          "url": {
            "selector": "a",
            "attr": "href",
            "absoluteUrl": true
          },
          "date": {
            "selector": "span.chapter-release-date i, span.chapter-release-date",
            "attr": "text"
          }
        }
      },
      "pages": {
        "request": {
          "method": "GET",
          "url": "{{chapterUrl}}",
          "queryParams": {
            "style": "list"
          }
        },
        "itemSelector": "div.reading-content img.wp-manga-chapter-img, div.page-break img",
        "imageUrl": {
          "attr": [
            "data-src",
            "data-lazy-src",
            "src"
          ],
          "absoluteUrl": true
        }
      }
    },
